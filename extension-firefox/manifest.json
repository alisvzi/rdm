{
  "manifest_version": 2,
  "name": "RDM Download Manager",
  "version": "0.3.0",
  "description": "هدایت دانلودهای مرورگر به برنامه‌ی RDM و دریافت ویدیو/صوت صفحه",
  "browser_specific_settings": { "gecko": { "id": "rdm@rdm.local" } },
  "permissions": ["downloads", "cookies", "contextMenus", "storage", "webRequest", "<all_urls>"],
  "background": { "scripts": ["common.js", "background.js"] },
  "browser_action": {
    "default_title": "RDM",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
