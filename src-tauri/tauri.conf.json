{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDM",
  "version": "0.6.2",
  "identifier": "com.rdm.downloadmanager",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "cargo build --release -p rdm-nm"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RDM Download Manager",
        "width": 980,
        "height": 600,
        "minWidth": 760,
        "minHeight": 440,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "RDM",
    "shortDescription": "RDM Download Manager",
    "longDescription": "Fast multi-connection download manager for Windows with browser integration.",
    "category": "Utility",
    "copyright": "RDM",
    "resources": {
      "../target/release/rdm-nm.exe": "rdm-nm.exe",
      "../native-messaging/install.ps1": "install.ps1",
      "../extension": "extension",
      "../extension-firefox": "extension-firefox"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "startMenuFolder": "RDM"
      }
    }
  }
}