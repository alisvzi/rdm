{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDM",
  "version": "0.3.0",
  "identifier": "com.rdm.downloadmanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RDM Download Manager",
        "width": 1080,
        "height": 660,
        "minWidth": 780,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
