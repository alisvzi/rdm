{
  "manifest_version": 3,
  "name": "RDM Download Manager",
  "version": "0.6.2",
  "description": "هدایت دانلودهای مرورگر به برنامه‌ی RDM و دریافت ویدیو/صوت صفحه",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "webRequest",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}